{
  "name": "baten-creative-portfolio",
  "version": "1.1.0",
  "type": "module",
  "description": "Portfolio of Md Abu Baten - AI Creative Director & Generative Video Specialist",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.input.css -o src/styles/tailwind.css --minify",
    "build:3d": "esbuild src/3d/reel.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=src/components/reel3d.bundle.js",
    "build": "npm run build:css && npm run build:3d"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "tailwindcss": "3.4.17",
    "three": "0.170.0"
  }
}
